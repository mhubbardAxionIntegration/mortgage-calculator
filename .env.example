# Public site URL (used by Stripe redirects / absolute links)
NEXT_PUBLIC_SITE_URL=https://smartmortgagecalc.com

# Inbox that receives contact-form messages (server-only; never exposed to the browser).
# Defaults to contact@smartmortgagecalc.com when unset (see src/lib/contactEmail.ts).
CONTACT_EMAIL=contact@smartmortgagecalc.com

# Required in production for /api/contact (nodemailer SMTP).
# Hostinger email example:
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#   SMTP_USER=contact@smartmortgagecalc.com
#   SMTP_PASS=<mailbox password from Hostinger Emails>
# SMTP_HOST defaults to smtp.hostinger.com when unset.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@smartmortgagecalc.com
SMTP_PASS=
# Optional From address (defaults to SMTP_USER). Must be allowed by your SMTP provider.
# SMTP_FROM="Smart Mortgage Calculator <contact@smartmortgagecalc.com>"

# Stripe (optional — premium PDF unlock)
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
# LICENSE_SECRET=
