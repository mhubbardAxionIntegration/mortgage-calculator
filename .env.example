# Copy to .env.local for local development. On Hostinger, set these in
# Website dashboard → Environment variables (not in a committed file).
# Saving env vars on Hostinger redeploys the app so process.env picks them up.

# Public site URL (optional — Stripe redirects / absolute links)
# NEXT_PUBLIC_SITE_URL=https://www.smartmortgagecalc.com

# Inbox that receives contact-form messages (server-only).
# Defaults to contact@smartmortgagecalc.com when unset.
# CONTACT_EMAIL=contact@smartmortgagecalc.com

# --- Contact form delivery (at least one path required in production) ---
# Order: Resend (if RESEND_API_KEY set) → SMTP (SMTP_USER + SMTP_PASS) → 503
#
# Option A — Resend (often easiest on hosts where SMTP env is flaky):
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Smart Mortgage Calculator <contact@smartmortgagecalc.com>
#   (or onboarding@resend.dev for testing before domain verification)
#
# Option B — Hostinger SMTP (primary names):
SMTP_USER=contact@smartmortgagecalc.com
SMTP_PASS=your-mailbox-password
# Optional SMTP:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_FROM=Smart Mortgage Calculator <contact@smartmortgagecalc.com>
#
# Accepted SMTP aliases: SMTP_USERNAME / SMTP_PASSWORD / MAIL_USER / MAIL_PASS

# --- Stripe / site (optional) ---
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
# LICENSE_SECRET=
